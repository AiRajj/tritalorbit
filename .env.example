# =====================================================================
# TRITAL Orbit™ — Environment Variables
# =====================================================================

# --- Database (PostgreSQL) ---------------------------------------------
# Use a hosted Postgres in production (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trital_orbit?schema=public"

# --- NextAuth / Auth.js ------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI (OpenAI compatible) -------------------------------------------
# Optional. When missing, the platform uses curated mock responses.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Email (Resend ready) ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="TRITAL Orbit <noreply@orbit.tritalcare.com>"

# --- Billing (Stripe ready) -------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""

# --- Public ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="TRITAL Orbit"
