# =============================================================================
# TRITAL Orbit™ — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/trital_orbit?schema=public"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# AI / OPENAI
# =============================================================================
# Required for AI agents (offer boost, risk scoring, readiness, concierge, MSP reports)
# If not provided, the system will use professional mock responses
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# =============================================================================
# EMAIL (Resend)
# =============================================================================
# Required for transactional emails (offer notifications, password reset, etc.)
RESEND_API_KEY=""
EMAIL_FROM="noreply@tritalorbit.com"

# =============================================================================
# PAYMENTS (Stripe)
# =============================================================================
# Required for subscription billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# FILE STORAGE
# =============================================================================
# For document vault and housing images
# Supports S3-compatible storage (AWS S3, Cloudflare R2, DigitalOcean Spaces)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"

# =============================================================================
# APPLICATION
# =============================================================================
APP_URL="http://localhost:3000"
APP_NAME="TRITAL Orbit"
NODE_ENV="development"
