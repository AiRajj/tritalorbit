generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  RECRUITER
  CONCIERGE_MANAGER
  MSP_VIEWER
  CANDIDATE
  VENDOR
  LANDLORD
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  BACKOUT
}

enum BookingStatus {
  NEW
  IN_PROGRESS
  WAITING_CANDIDATE
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReadinessStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum VendorType {
  HOUSING
  TRAVEL
  CAR_RENTAL
  RELOCATION
  CONCIERGE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  hashedPassword String?
  phone          String?
  role           UserRole  @default(CANDIDATE)
  avatar         String?
  emailVerified  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  agencyMembers AgencyMember[]
  candidateProfile Candidate?
  vendorProfile    Vendor?
  landlordProfile  Landlord?
  notifications    Notification[]
  activityLogs     ActivityLog[]
  auditLogs        AuditLog[]
  conciergeTasks   ConciergeTask[] @relation("AssignedConcierge")
  aiInsights       AIInsight[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agency {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  phone       String?
  address     String?
  city        String?
  state       String?
  description String?
  isActive    Boolean  @default(true)
  subscriptionTier SubscriptionTier @default(STARTER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AgencyMember[]
  candidates  Candidate[]
  assignments Assignment[]
  offers      Offer[]
  bookingRequests BookingRequest[]
  mspReports  MSPReport[]
  paymentRecords PaymentRecord[]

  @@index([slug])
}

model AgencyMember {
  id        String   @id @default(uuid())
  userId    String
  agencyId  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([userId, agencyId])
}

model Candidate {
  id              String   @id @default(uuid())
  userId          String   @unique
  agencyId        String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  role            String?
  specialty       String?
  licenseState    String?
  experience      Int?
  currentCity     String?
  currentState    String?
  isActive        Boolean  @default(true)
  engagementScore Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency          Agency?  @relation(fields: [agencyId], references: [id])
  offers          Offer[]
  assignments     Assignment[]
  bookingRequests BookingRequest[]
  retentionRisks  RetentionRiskScore[]
  documents       DocumentVault[]

  @@index([email])
}

model Assignment {
  id              String   @id @default(uuid())
  agencyId        String
  candidateId     String?
  facilityName    String
  city            String
  state           String
  startDate       DateTime?
  endDate         DateTime?
  duration        Int?
  shift           String?
  specialty       String?
  mspClient       String?
  status          String   @default("OPEN")
  housingStatus   ReadinessStatus @default(NOT_STARTED)
  travelStatus    ReadinessStatus @default(NOT_STARTED)
  documentsStatus ReadinessStatus @default(NOT_STARTED)
  firstWeekReady  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agency    Agency     @relation(fields: [agencyId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])
  offers    Offer[]

  @@index([agencyId])
  @@index([candidateId])
}

model Offer {
  id                String      @id @default(uuid())
  agencyId          String
  candidateId       String
  assignmentId      String?
  token             String      @unique @default(uuid())
  status            OfferStatus @default(DRAFT)
  weeklyPay         Float?
  taxableRate       Float?
  stipend           Float?
  totalContractValue Float?
  facilityName      String?
  city              String?
  state             String?
  startDate         DateTime?
  duration          Int?
  shift             String?
  specialty         String?
  mspClient         String?
  enhancedSummary   String?
  valueStatement    String?
  recruiterTalkingPoints String?
  smsPitch          String?
  emailPitch        String?
  candidateConfidenceScore Int?
  aiCloseStrategy   String?
  viewedAt          DateTime?
  respondedAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  agency     Agency     @relation(fields: [agencyId], references: [id])
  candidate  Candidate  @relation(fields: [candidateId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  perks      OfferPerk[]
  bookingRequests BookingRequest[]
  activityLogs    ActivityLog[]
  retentionRisk   RetentionRiskScore?

  @@index([agencyId])
  @@index([candidateId])
  @@index([token])
  @@index([status])
}

model OfferPerk {
  id          String  @id @default(uuid())
  offerId     String
  perkType    String
  title       String
  description String?
  isEnabled   Boolean @default(true)
  value       Float?
  createdAt   DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model BookingRequest {
  id            String        @id @default(uuid())
  offerId       String
  candidateId   String
  agencyId      String
  needsFlight   Boolean       @default(false)
  needsHousing  Boolean       @default(false)
  needsCar      Boolean       @default(false)
  moveDate      DateTime?
  budgetMin     Float?
  budgetMax     Float?
  preferredLocation String?
  notes         String?
  status        BookingStatus @default(NEW)
  conciergeOwnerId String?
  timeline      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offer     Offer     @relation(fields: [offerId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
  agency    Agency    @relation(fields: [agencyId], references: [id])
  conciergeTasks ConciergeTask[]

  @@index([offerId])
  @@index([candidateId])
  @@index([status])
}

model HousingOption {
  id            String   @id @default(uuid())
  vendorId      String?
  landlordId    String?
  title         String
  description   String?
  address       String?
  city          String
  state         String
  zipCode       String?
  monthlyCost   Float?
  availability  DateTime?
  distanceToFacility Float?
  amenities     String?
  images        String[]
  isVerified    Boolean  @default(false)
  rating        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
  landlord Landlord? @relation(fields: [landlordId], references: [id])

  @@index([city, state])
}

model TravelOption {
  id          String   @id @default(uuid())
  vendorId    String?
  type        String
  origin      String?
  destination String?
  cost        Float?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id])
}

model CarRentalOption {
  id          String   @id @default(uuid())
  vendorId    String?
  company     String
  vehicleType String?
  dailyRate   Float?
  weeklyRate  Float?
  city        String?
  state       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  vendor Vendor? @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id                 String             @id @default(uuid())
  userId             String             @unique
  companyName        String
  contactName        String?
  email              String
  phone              String?
  website            String?
  vendorType         VendorType
  city               String?
  state              String?
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  housingOptions HousingOption[]
  travelOptions  TravelOption[]
  carRentalOptions CarRentalOption[]

  @@index([vendorType])
  @@index([verificationStatus])
}

model Landlord {
  id                 String             @id @default(uuid())
  userId             String             @unique
  name               String
  email              String
  phone              String?
  city               String?
  state              String?
  description        String?
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  housingOptions HousingOption[]
}

model ConciergeTask {
  id              String        @id @default(uuid())
  bookingRequestId String
  assignedToId    String?
  title           String
  description     String?
  status          BookingStatus @default(NEW)
  priority        String        @default("MEDIUM")
  dueDate         DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id])
  assignedTo     User?          @relation("AssignedConcierge", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  offerId   String?
  action    String
  details   String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  offer Offer? @relation(fields: [offerId], references: [id])

  @@index([userId])
  @@index([offerId])
  @@index([action])
  @@index([createdAt])
}

model RetentionRiskScore {
  id               String    @id @default(uuid())
  offerId          String    @unique
  candidateId      String
  riskScore        Int       @default(0)
  riskLevel        RiskLevel @default(LOW)
  reasoning        String?
  suggestedAction  String?
  suggestedSms     String?
  suggestedScript  String?
  viewedOffer      Boolean   @default(false)
  timeSinceOfferSent Int?
  housingRequested Boolean   @default(false)
  travelRequested  Boolean   @default(false)
  engagementScore  Int       @default(0)
  unansweredMessages Int     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offer     Offer     @relation(fields: [offerId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([riskLevel])
  @@index([candidateId])
}

model AIInsight {
  id          String   @id @default(uuid())
  userId      String?
  type        String
  prompt      String?
  response    String?
  model       String?
  tokensUsed  Int?
  cost        Float?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([type])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SubscriptionPlan {
  id          String           @id @default(uuid())
  name        String
  tier        SubscriptionTier @unique
  price       Float
  currency    String           @default("USD")
  interval    String           @default("monthly")
  features    String[]
  maxUsers    Int?
  maxOffers   Int?
  isActive    Boolean          @default(true)
  stripePriceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PaymentRecord {
  id              String   @id @default(uuid())
  agencyId        String
  amount          Float
  currency        String   @default("USD")
  status          String   @default("PENDING")
  stripePaymentId String?
  invoiceUrl      String?
  description     String?
  createdAt       DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

model DocumentVault {
  id          String   @id @default(uuid())
  candidateId String
  fileName    String
  fileType    String?
  fileUrl     String?
  category    String?
  isVerified  Boolean  @default(false)
  uploadedAt  DateTime @default(now())
  expiresAt   DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}

model MSPReport {
  id          String   @id @default(uuid())
  agencyId    String?
  reportType  String
  title       String
  data        Json?
  summary     String?
  dateFrom    DateTime?
  dateTo      DateTime?
  generatedBy String?
  createdAt   DateTime @default(now())

  agency Agency? @relation(fields: [agencyId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  role      String?
  message   String?
  source    String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model DemoRequest {
  id           String   @id @default(uuid())
  name         String
  email        String
  company      String
  phone        String?
  role         String?
  companySize  String?
  currentTools String?
  message      String?
  preferredDate DateTime?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
}
