generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AGENCY_OWNER
  RECRUITER
  CONCIERGE_MANAGER
  MSP_VIEWER
  CANDIDATE
  VENDOR_LANDLORD
  TRAVEL_AGENCY_VENDOR
  HOUSING_PROVIDER
  HOTEL_PARTNER
  CAR_RENTAL_PARTNER
  RELOCATION_PARTNER
  FINANCE_BILLING_ADMIN
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  BACKOUT_RISK
  CANCELLED
}

enum BookingStatus {
  NEW
  IN_PROGRESS
  WAITING_CANDIDATE
  COMPLETED
  CANCELLED
}

enum ReadinessStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  BLOCKED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  WAITING_CANDIDATE
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  WARNING
  ACTION_REQUIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LeadSource {
  PRICING
  CONTACT
  WEBSITE
}

enum AIInsightType {
  OFFER_BOOST
  RISK_SCORE
  READINESS
  CONCIERGE
  MSP_REPORT
}

enum MobilityRequestStatus {
  OPEN
  BID_ACTIVE
  EXPIRED
  BOOKED
  CANCELLED
}

enum MobilityBidStatus {
  ACTIVE
  SELECTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum MobilityPackageType {
  FLIGHT_ONLY
  FLIGHT_CAR
  FLIGHT_HOTEL
  FULL_RELOCATION
}

enum WalletAccountType {
  AGENCY
  CANDIDATE
}

enum WalletEntryType {
  FUNDING
  CREDIT_GRANT
  REDEMPTION
  PAYOUT
  ADJUSTMENT
  REFUND
}

enum WalletEntryStatus {
  PENDING
  POSTED
  REVERSED
  FAILED
}

enum ComparisonSourceType {
  INTERNAL_OFFER
  EXTERNAL_OFFER
}

enum ComparisonStatus {
  DRAFT
  ANALYZED
  FINALIZED
  ARCHIVED
}

enum RewardsTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  ORBIT_ELITE
}

enum RewardEventType {
  ASSIGNMENT_COMPLETED
  QUICK_ACCEPTANCE
  VENDOR_BOOKING
  REFERRAL
  BONUS
  MANUAL_ADJUSTMENT
}

enum RewardRedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum MobilityRequestType {
  FLIGHT
  HOUSING
  CAR_RENTAL
  HOTEL
  FULL_RELOCATION_PACKAGE
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MobilityRequestWorkflowStatus {
  DRAFT
  OPEN_FOR_BIDS
  REVIEWING
  BID_ACCEPTED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum MobilityBidType {
  FLIGHT
  HOUSING
  CAR_RENTAL
  HOTEL
  FULL_PACKAGE
}

enum MobilityBidWorkflowStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum MobilityBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentResponsibility {
  CANDIDATE
  AGENCY
  SHARED
  WALLET_CREDIT
}

enum VendorCategory {
  TRAVEL_AGENCY
  HOUSING_PROVIDER
  CAR_RENTAL
  HOTEL
  RELOCATION_VENDOR
}

enum WalletOwnerType {
  CANDIDATE
  AGENCY
  VENDOR
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletCreditType {
  FLIGHT
  HOUSING
  HOTEL
  CAR_RENTAL
  RELOCATION
  EMERGENCY
  GENERAL
}

enum WalletCreditStatus {
  ACTIVE
  USED
  PARTIALLY_USED
  EXPIRED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT_ADDED
  CREDIT_USED
  REFUND
  VENDOR_PAYOUT
  PLATFORM_FEE
  ADJUSTMENT
}

enum VerificationReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ClinicianSubscriptionStatus {
  ACTIVE
  CANCELED
  TRIALING
  PAST_DUE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?
  phone        String?
  image        String?
  role         Role     @default(CANDIDATE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agenciesOwned               Agency[]                @relation("AgencyOwner")
  memberships                 AgencyMember[]
  candidate                   Candidate?
  vendors                     Vendor[]
  landlords                   Landlord[]
  offersCreated               Offer[]                 @relation("RecruiterOffers")
  conciergeTasks              ConciergeTask[]         @relation("ConciergeTaskOwner")
  notifications               Notification[]
  activityLogs                ActivityLog[]
  auditLogs                   AuditLog[]
  mspReports                  MSPReport[]
  travelBidRequestsCreated    TravelBidRequest[]      @relation("TravelRequestCreator")
  travelBidsSubmitted         TravelBid[]             @relation("TravelBidSubmitter")
  walletEntriesCreated        WalletLedgerEntry[]     @relation("WalletEntryCreator")
  uploadedExternalOffers      ExternalOfferDocument[] @relation("ExternalOfferUploader")
  createdOfferComparisons     OfferComparison[]       @relation("OfferComparisonCreator")
  awardedRewardEvents         RewardEvent[]           @relation("RewardEventAwarder")
  requestedRedemptions        RewardRedemption[]      @relation("RewardRedemptionRequester")
  mobilityRequestsCreated     MobilityRequest[]       @relation("MobilityRequestCreator")
  mobilityBidsSubmittedV2     MobilityBid[]           @relation("MobilityBidUser")
  mobilityBookingsCreated     MobilityBooking[]       @relation("MobilityBookingCreator")
  vendorVerificationsReviewed VendorVerification[]    @relation("VendorVerificationReviewer")
  disputesRaised              Dispute[]               @relation("DisputeRaiser")

  accounts Account[]
  sessions Session[]
}

model Agency {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  ownerId        String
  primaryColor   String   @default("#0B3C5D")
  secondaryColor String   @default("#E63946")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner                  User                    @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                AgencyMember[]
  candidates             Candidate[]
  assignments            Assignment[]
  offers                 Offer[]
  bookingRequests        BookingRequest[]
  conciergeTasks         ConciergeTask[]
  activityLogs           ActivityLog[]
  subscriptionPlans      SubscriptionPlan[]
  paymentRecords         PaymentRecord[]
  mspReports             MSPReport[]
  auditLogs              AuditLog[]
  travelBidRequests      TravelBidRequest[]
  walletAccount          WalletAccount?
  walletLedgerEntries    WalletLedgerEntry[]
  rewardEvents           RewardEvent[]
  rewardRedemptions      RewardRedemption[]
  mobilityRequestsV2     MobilityRequest[]
  mobilityBookingsV2     MobilityBooking[]
  offerComparisonsV2     OfferComparisonV2[]
  walletsV2              Wallet[]
  walletCreditsV2        WalletCredit[]
  walletTransactionsV2   WalletTransaction[]
  firstWeekGuides        FirstWeekGuide[]
  offerIntelligence      OfferIntelligence[]
  partnerHousingListings PartnerHousingListing[]
  housingInquiries       HousingInquiry[]
  disputes               Dispute[]
  clinicianSubscriptions ClinicianSubscription[]
}

model AgencyMember {
  id        String   @id @default(uuid())
  agencyId  String
  userId    String
  title     String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model Candidate {
  id                 String   @id @default(uuid())
  userId             String?  @unique
  agencyId           String
  name               String
  email              String
  phone              String?
  role               String
  specialty          String
  licenseState       String
  experienceYears    Int      @default(0)
  engagementScore    Float    @default(0)
  unreadMessageCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                  User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  agency                Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  offers                Offer[]
  assignments           Assignment[]
  bookingRequests       BookingRequest[]
  retentionRiskScores   RetentionRiskScore[]
  documentVault         DocumentVault[]
  aiInsights            AIInsight[]
  activityLogs          ActivityLog[]
  conciergeTasks        ConciergeTask[]
  travelBidRequests     TravelBidRequest[]
  walletAccount         WalletAccount?
  walletLedgerEntries   WalletLedgerEntry[]
  externalOffers        ExternalOfferDocument[]
  offerComparisons      OfferComparison[]
  rewardsAccount        RewardsAccount?
  rewardEvents          RewardEvent[]
  rewardRedemptions     RewardRedemption[]
  mobilityRequestsV2    MobilityRequest[]
  mobilityBookingsV2    MobilityBooking[]
  offerComparisonsV2    OfferComparisonV2[]
  relocationPlans       RelocationPlan[]
  firstWeekGuides       FirstWeekGuide[]
  offerIntelligence     OfferIntelligence[]
  clinicianSubscription ClinicianSubscription?
  walletsV2             Wallet[]
  walletCreditsV2       WalletCredit[]
  walletTransactionsV2  WalletTransaction[]
  housingInquiries      HousingInquiry[]
}

model Assignment {
  id                 String          @id @default(uuid())
  agencyId           String
  candidateId        String
  facilityName       String
  city               String
  state              String
  mspClient          String?
  role               String
  specialty          String
  startDate          DateTime
  durationWeeks      Int
  shift              String
  readinessStatus    ReadinessStatus @default(NOT_STARTED)
  documentsStatus    ReadinessStatus @default(NOT_STARTED)
  housingStatus      ReadinessStatus @default(NOT_STARTED)
  travelStatus       ReadinessStatus @default(NOT_STARTED)
  firstWeekReadiness Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  agency              Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offers              Offer[]
  housingOptions      HousingOption[]
  travelOptions       TravelOption[]
  carRentalOptions    CarRentalOption[]
  bookingRequests     BookingRequest[]
  conciergeTasks      ConciergeTask[]
  documentVault       DocumentVault[]
  activityLogs        ActivityLog[]
  retentionRiskScores RetentionRiskScore[]
  aiInsights          AIInsight[]
  travelBidRequests   TravelBidRequest[]
  mobilityRequestsV2  MobilityRequest[]
  mobilityBookingsV2  MobilityBooking[]
  firstWeekGuides     FirstWeekGuide[]
  relocationPlans     RelocationPlan[]
  offerIntelligence   OfferIntelligence[]
  walletCredits       WalletCredit[]
  offerComparisonV2s  OfferComparisonV2[]
}

model Offer {
  id           String      @id @default(uuid())
  agencyId     String
  candidateId  String
  assignmentId String
  recruiterId  String
  status       OfferStatus @default(DRAFT)
  token        String      @unique @default(uuid())

  weeklyPay              Decimal @db.Decimal(10, 2)
  taxableRate            Decimal @db.Decimal(10, 2)
  stipend                Decimal @db.Decimal(10, 2)
  estimatedContractValue Decimal @db.Decimal(12, 2)

  enhancedOfferSummary     String?
  candidateValueStatement  String?
  recruiterTalkingPoints   String?
  smsPitch                 String?
  emailPitch               String?
  closeStrategy            String?
  pdfReadyOffer            String?
  candidateConfidenceScore Int?

  viewedAt   DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agency              Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate           Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment          Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  recruiter           User                   @relation("RecruiterOffers", fields: [recruiterId], references: [id], onDelete: Cascade)
  perks               OfferPerk[]
  bookingRequests     BookingRequest[]
  retentionRiskScores RetentionRiskScore[]
  aiInsights          AIInsight[]
  activityLogs        ActivityLog[]
  travelBidRequests   TravelBidRequest[]
  comparisonEntries   OfferComparisonEntry[] @relation("ComparisonEntryInternalOffer")
  primaryComparisons  OfferComparison[]      @relation("ComparisonPrimaryOffer")
  mobilityRequestsV2  MobilityRequest[]
  offerComparisonsV2  OfferComparisonV2[]
  offerIntelligence   OfferIntelligence[]
  outreachLogs        OfferOutreachLog[]
}

model OfferPerk {
  id        String   @id @default(uuid())
  offerId   String
  name      String
  enabled   Boolean  @default(false)
  valueNote String?
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model BookingRequest {
  id                String        @id @default(uuid())
  agencyId          String
  candidateId       String
  assignmentId      String
  offerId           String
  needFlight        Boolean       @default(false)
  needHousing       Boolean       @default(false)
  needCar           Boolean       @default(false)
  moveDate          DateTime?
  budgetRange       String?
  preferredLocation String?
  notes             String?
  status            BookingStatus @default(NEW)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  agency         Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment     Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  offer          Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  conciergeTasks ConciergeTask[]
}

model TravelBidRequest {
  id                  String                @id @default(uuid())
  agencyId            String
  candidateId         String
  assignmentId        String
  offerId             String?
  createdById         String?
  status              MobilityRequestStatus @default(OPEN)
  originAirport       String?
  preferredAirport    String
  departureDate       DateTime
  returnDate          DateTime?
  needCar             Boolean               @default(false)
  needHotel           Boolean               @default(false)
  baggageCount        Int                   @default(1)
  carType             String?
  hotelNights         Int?
  specialRequirements String?
  agencyTravelCredit  Decimal               @default(0) @db.Decimal(10, 2)
  bidExpiresAt        DateTime
  selectedBidId       String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  agency              Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate           Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment          Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  offer               Offer?              @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("TravelRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  bids                TravelBid[]         @relation("RequestBids")
  selectedBid         TravelBid?          @relation("SelectedTravelBid", fields: [selectedBidId], references: [id], onDelete: SetNull)
  walletLedgerEntries WalletLedgerEntry[]

  @@index([assignmentId, status])
  @@index([agencyId, bidExpiresAt])
}

model TravelBid {
  id                     String              @id @default(uuid())
  requestId              String
  vendorId               String
  submittedById          String?
  status                 MobilityBidStatus   @default(ACTIVE)
  packageType            MobilityPackageType @default(FLIGHT_ONLY)
  airline                String
  flightType             String
  stops                  Int                 @default(0)
  totalPrice             Decimal             @db.Decimal(10, 2)
  currency               String              @default("USD")
  includesCar            Boolean             @default(false)
  includesHotel          Boolean             @default(false)
  carProvider            String?
  hotelName              String?
  notes                  String?
  expiresAt              DateTime
  recommendedByConcierge Boolean             @default(false)
  selectedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  request             TravelBidRequest    @relation("RequestBids", fields: [requestId], references: [id], onDelete: Cascade)
  vendor              Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submittedBy         User?               @relation("TravelBidSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  selectedForRequest  TravelBidRequest?   @relation("SelectedTravelBid")
  walletLedgerEntries WalletLedgerEntry[]

  @@index([requestId, status])
  @@index([vendorId, createdAt])
}

model ExternalOfferDocument {
  id                    String   @id @default(uuid())
  candidateId           String
  uploadedById          String?
  sourceLabel           String
  agencyName            String
  role                  String
  specialty             String
  locationCity          String
  locationState         String
  weeklyPay             Decimal  @db.Decimal(10, 2)
  taxableRate           Decimal? @db.Decimal(10, 2)
  stipend               Decimal? @db.Decimal(10, 2)
  durationWeeks         Int?
  travelSupportScore    Int      @default(50)
  housingSupportScore   Int      @default(50)
  readinessSupportScore Int      @default(50)
  costOfLivingIndex     Float    @default(1)
  rawText               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  candidate         Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy        User?                  @relation("ExternalOfferUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  comparisonEntries OfferComparisonEntry[]

  @@index([candidateId, createdAt])
}

model OfferComparison {
  id                  String           @id @default(uuid())
  candidateId         String
  primaryOfferId      String?
  createdById         String?
  status              ComparisonStatus @default(DRAFT)
  recommendationTitle String?
  executiveSummary    String?
  bestOverallLabel    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  candidate    Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  primaryOffer Offer?                   @relation("ComparisonPrimaryOffer", fields: [primaryOfferId], references: [id], onDelete: SetNull)
  createdBy    User?                    @relation("OfferComparisonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries      OfferComparisonEntry[]
  insights     OfferComparisonInsight[]

  @@index([candidateId, status])
}

model OfferComparisonEntry {
  id                    String               @id @default(uuid())
  comparisonId          String
  sourceType            ComparisonSourceType
  internalOfferId       String?
  externalOfferId       String?
  label                 String
  weeklyPay             Decimal              @db.Decimal(10, 2)
  stipend               Decimal              @db.Decimal(10, 2)
  durationWeeks         Int
  city                  String
  state                 String
  travelSupportScore    Int                  @default(50)
  housingSupportScore   Int                  @default(50)
  readinessSupportScore Int                  @default(50)
  costOfLivingIndex     Float                @default(1)
  totalValueScore       Float                @default(0)
  lifestyleScore        Float                @default(0)
  notes                 String?
  createdAt             DateTime             @default(now())

  comparison    OfferComparison        @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  internalOffer Offer?                 @relation("ComparisonEntryInternalOffer", fields: [internalOfferId], references: [id], onDelete: SetNull)
  externalOffer ExternalOfferDocument? @relation(fields: [externalOfferId], references: [id], onDelete: SetNull)

  @@index([comparisonId, sourceType])
}

model OfferComparisonInsight {
  id           String   @id @default(uuid())
  comparisonId String
  heading      String
  detail       String
  rank         Int      @default(1)
  aiModel      String
  createdAt    DateTime @default(now())

  comparison OfferComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId, rank])
}

model HousingOption {
  id                 String             @id @default(uuid())
  assignmentId       String
  vendorId           String?
  landlordId         String?
  title              String
  city               String
  state              String
  distanceMiles      Float
  monthlyCost        Decimal            @db.Decimal(10, 2)
  availableFrom      DateTime
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  landlord   Landlord?  @relation(fields: [landlordId], references: [id], onDelete: SetNull)
}

model TravelOption {
  id                 String             @id @default(uuid())
  assignmentId       String
  vendorId           String?
  providerName       String
  city               String
  state              String
  estimatedCost      Decimal            @db.Decimal(10, 2)
  availableFrom      DateTime
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model CarRentalOption {
  id                 String             @id @default(uuid())
  assignmentId       String
  vendorId           String?
  providerName       String
  city               String
  state              String
  weeklyCost         Decimal            @db.Decimal(10, 2)
  availableFrom      DateTime
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

model Vendor {
  id                 String             @id @default(uuid())
  ownerId            String?
  name               String
  category           String
  city               String
  state              String
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float?
  contactEmail       String
  contactPhone       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner                  User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  housingOptions         HousingOption[]
  travelOptions          TravelOption[]
  carRentalOptions       CarRentalOption[]
  travelBids             TravelBid[]
  mobilityBidsV2         MobilityBid[]
  mobilityBookingsV2     MobilityBooking[]
  bidProfile             VendorBidProfile?
  verifications          VendorVerification[]
  partnerHousingListings PartnerHousingListing[]
  housingInquiries       HousingInquiry[]
  walletsV2              Wallet[]
  walletTransactionsV2   WalletTransaction[]
  disputes               Dispute[]
}

model Landlord {
  id                 String             @id @default(uuid())
  ownerId            String?
  companyName        String
  city               String
  state              String
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float?
  contactEmail       String
  contactPhone       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  housingOptions HousingOption[]
}

model ConciergeTask {
  id               String     @id @default(uuid())
  agencyId         String
  bookingRequestId String?
  assignmentId     String?
  candidateId      String?
  ownerId          String?
  title            String
  description      String?
  status           TaskStatus @default(NEW)
  priority         Priority   @default(MEDIUM)
  dueDate          DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  agency         Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingRequest BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  assignment     Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  candidate      Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  owner          User?           @relation("ConciergeTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
}

model ActivityLog {
  id           String   @id @default(uuid())
  agencyId     String
  actorId      String?
  candidateId  String?
