generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  RECRUITER
  CONCIERGE_MANAGER
  MSP_VIEWER
  CANDIDATE
  VENDOR
  LANDLORD
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  DRAFT
  OPEN
  OFFERED
  ACCEPTED
  READY
  STARTED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  BACKOUT_RISK
  EXPIRED
}

enum BookingStatus {
  NEW
  IN_PROGRESS
  WAITING_CANDIDATE
  COMPLETED
  CANCELLED
}

enum PerkType {
  FLIGHT_SUPPORT
  HOUSING_ASSISTANCE
  CAR_RENTAL
  RELOCATION_CONCIERGE
  FIRST_WEEK_READINESS
  EMERGENCY_HOUSING
  LOYALTY_REWARDS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RiskLabel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  phone          String?
  passwordHash   String?
  role           UserRole        @default(CANDIDATE)
  avatarUrl      String?
  title          String?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  agencyMembers  AgencyMember[]
  candidate      Candidate?
  vendor         Vendor?
  landlord       Landlord?
  notifications  Notification[]
  activityLogs   ActivityLog[]
  auditLogs      AuditLog[]      @relation("AuditActor")
  conciergeTasks ConciergeTask[] @relation("TaskOwner")
}

model Agency {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  website           String?
  logoUrl           String?
  industrySegment   String             @default("Healthcare staffing")
  billingEmail      String?
  status            MemberStatus       @default(ACTIVE)
  stripeCustomerId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           AgencyMember[]
  candidates        Candidate[]
  assignments       Assignment[]
  offers            Offer[]
  bookingRequests   BookingRequest[]
  subscriptionPlans SubscriptionPlan[]
  paymentRecords    PaymentRecord[]
  mspReports        MSPReport[]
}

model AgencyMember {
  id        String       @id @default(uuid())
  agencyId  String
  userId    String
  role      UserRole
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
}

model Candidate {
  id              String           @id @default(uuid())
  userId          String?          @unique
  agencyId        String
  name            String
  email           String           @unique
  phone           String?
  role            String
  specialty       String
  licenseState    String
  yearsExperience Int              @default(0)
  engagementScore Int              @default(72)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id])
  agency          Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  offers          Offer[]
  bookingRequests BookingRequest[]
  documentVault   DocumentVault[]
  activityLogs    ActivityLog[]
}

model Assignment {
  id              String            @id @default(uuid())
  agencyId        String
  candidateId     String?
  facilityName    String
  city            String
  state           String
  specialty       String
  shift           String
  startDate       DateTime
  durationWeeks   Int
  mspClient       String?
  status          AssignmentStatus  @default(OPEN)
  housingStatus   String            @default("Not requested")
  travelStatus    String            @default("Not requested")
  documentsStatus String            @default("Pending")
  readinessScore  Int               @default(41)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  agency          Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate       Candidate?        @relation(fields: [candidateId], references: [id])
  offers          Offer[]
  bookingRequests BookingRequest[]
  housingOptions  HousingOption[]
  travelOptions   TravelOption[]
  carOptions      CarRentalOption[]
}

model Offer {
  id                  String               @id @default(uuid())
  agencyId            String
  candidateId         String
  assignmentId        String
  token               String               @unique @default(uuid())
  status              OfferStatus          @default(DRAFT)
  weeklyPay           Decimal              @db.Decimal(10, 2)
  taxableRate         Decimal              @db.Decimal(10, 2)
  stipend             Decimal              @db.Decimal(10, 2)
  totalContractValue  Decimal              @db.Decimal(12, 2)
  enhancedSummary     String?
  valueStatement      String?
  recruiterTalkingPts String?
  smsPitch            String?
  emailPitch          String?
  pdfReadyOffer       String?
  closeStrategy       String?
  candidateConfidence Int                  @default(74)
  sentAt              DateTime?
  viewedAt            DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agency              Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment          Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  perks               OfferPerk[]
  bookingRequests     BookingRequest[]
  riskScores          RetentionRiskScore[]
  aiInsights          AIInsight[]
  activityLogs        ActivityLog[]
}

model OfferPerk {
  id          String   @id @default(uuid())
  offerId     String
  type        PerkType
  title       String
  description String
  included    Boolean  @default(true)
  createdAt   DateTime @default(now())
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model BookingRequest {
  id                String          @id @default(uuid())
  agencyId          String
  candidateId       String
  assignmentId      String
  offerId           String?
  status            BookingStatus   @default(NEW)
  needsFlight       Boolean         @default(false)
  needsHousing      Boolean         @default(false)
  needsCar          Boolean         @default(false)
  moveDate          DateTime
  budgetRange       String?
  preferredLocation String?
  notes             String?
  conciergeOwnerId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  agency            Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate         Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment        Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  offer             Offer?          @relation(fields: [offerId], references: [id])
  conciergeTasks    ConciergeTask[]
}

model HousingOption {
  id                 String             @id @default(uuid())
  assignmentId       String?
  landlordId         String?
  title              String
  city               String
  state              String
  address            String?
  distanceToFacility Float?
  monthlyCost        Decimal            @db.Decimal(10, 2)
  availabilityStart  DateTime?
  availabilityEnd    DateTime?
  bedrooms           Int                @default(1)
  furnished          Boolean            @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(4.7)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignment         Assignment?        @relation(fields: [assignmentId], references: [id])
  landlord           Landlord?          @relation(fields: [landlordId], references: [id])
}

model TravelOption {
  id            String      @id @default(uuid())
  assignmentId  String?
  title         String
  provider      String
  route         String
  estimatedCost Decimal     @db.Decimal(10, 2)
  refundable    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assignment    Assignment? @relation(fields: [assignmentId], references: [id])
}

model CarRentalOption {
  id           String      @id @default(uuid())
  assignmentId String?
  vendorId     String?
  vehicleClass String
  city         String
  state        String
  weeklyCost   Decimal     @db.Decimal(10, 2)
  availability String      @default("Available")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  vendor       Vendor?     @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id                 String             @id @default(uuid())
  userId             String?            @unique
  name               String
  category           String
  city               String
  state              String
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(4.8)
  contactEmail       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User?              @relation(fields: [userId], references: [id])
  carOptions         CarRentalOption[]
}

model Landlord {
  id                 String             @id @default(uuid())
  userId             String?            @unique
  name               String
  company            String?
  city               String
  state              String
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(4.7)
  contactEmail       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User?              @relation(fields: [userId], references: [id])
  housingOptions     HousingOption[]
}

model ConciergeTask {
  id               String          @id @default(uuid())
  bookingRequestId String?
  ownerId          String?
  title            String
  description      String
  status           BookingStatus   @default(NEW)
  priority         String          @default("Medium")
  dueAt            DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])
  owner            User?           @relation("TaskOwner", fields: [ownerId], references: [id])
}

model ActivityLog {
  id          String     @id @default(uuid())
  agencyId    String?
  candidateId String?
  offerId     String?
  actorId     String?
  type        String
  message     String
  metadata    Json?
  createdAt   DateTime   @default(now())
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  offer       Offer?     @relation(fields: [offerId], references: [id])
  actor       User?      @relation(fields: [actorId], references: [id])
}

model RetentionRiskScore {
  id                       String    @id @default(uuid())
  offerId                  String
  score                    Int
  label                    RiskLabel
  reasoning                String
  suggestedRecruiterAction String
  suggestedSms             String
  suggestedCallScript      String
  createdAt                DateTime  @default(now())
  offer                    Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id        String   @id @default(uuid())
  offerId   String?
  agent     String
  prompt    String
  response  Json
  model     String   @default("mock-or-openai-compatible")
  createdAt DateTime @default(now())
  offer     Offer?   @relation(fields: [offerId], references: [id])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String?
  title     String
  body      String
  status    NotificationStatus @default(UNREAD)
  href      String?
  createdAt DateTime           @default(now())
  user      User?              @relation(fields: [userId], references: [id])
}

model SubscriptionPlan {
  id               String             @id @default(uuid())
  agencyId         String
  name             String
  stripePriceId    String?
  status           SubscriptionStatus @default(TRIALING)
  seats            Int                @default(5)
  monthlyAmount    Decimal            @db.Decimal(10, 2)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  agency           Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model PaymentRecord {
  id              String    @id @default(uuid())
  agencyId        String
  stripePaymentId String?
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("usd")
  status          String
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model DocumentVault {
  id          String    @id @default(uuid())
  candidateId String
  title       String
  type        String
  status      String    @default("Pending")
  secureUrl   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model MSPReport {
  id               String   @id @default(uuid())
  agencyId         String?
  title            String
  dateRange        String
  acceptanceRate   Float
  backoutRate      Float
  timeToReadyDays  Float
  firstDayShowRate Float
  readinessRate    Float
  supplierScore    Float
  aiSummary        String
  createdAt        DateTime @default(now())
  agency           Agency?  @relation(fields: [agencyId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  role      String?
  message   String?
  source    String   @default("website")
  createdAt DateTime @default(now())
}

model DemoRequest {
  id            String   @id @default(uuid())
  name          String
  email         String
  company       String
  role          String?
  teamSize      String?
  currentPain   String?
  preferredTime String?
  createdAt     DateTime @default(now())
}
