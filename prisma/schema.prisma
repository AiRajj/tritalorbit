// =====================================================================
// TRITAL Orbit™ — Prisma Schema
// Healthcare Workforce Mobility Infrastructure
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  AGENCY_OWNER
  RECRUITER
  CONCIERGE_MANAGER
  MSP_VIEWER
  CANDIDATE
  VENDOR
  LANDLORD
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum AssignmentStatus {
  PENDING
  PRE_START
  ACTIVE
  COMPLETED
  CANCELLED
  BACKED_OUT
}

enum BookingType {
  FLIGHT
  HOUSING
  CAR
  RELOCATION
  CONCIERGE
}

enum BookingStatus {
  NEW
  IN_PROGRESS
  WAITING_CANDIDATE
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VendorType {
  HOUSING
  TRAVEL
  CAR_RENTAL
  CONCIERGE
  RELOCATION
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  OFFER
  BOOKING
  RISK
  TASK
  SYSTEM
  AI
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  SEND
  ACCEPT
  DECLINE
}

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

// ---------------------------------------------------------------------
// Auth.js core models
// ---------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  passwordHash    String?
  role            UserRole  @default(CANDIDATE)
  phone           String?
  title           String?
  bio             String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agencyId        String?
  agency          Agency?   @relation("AgencyUsers", fields: [agencyId], references: [id], onDelete: SetNull)

  ownedAgencies   Agency[]  @relation("AgencyOwner")
  agencyMembers   AgencyMember[]
  candidate       Candidate?
  recruitedOffers Offer[]   @relation("OfferRecruiter")
  conciergeTasks  ConciergeTask[] @relation("ConciergeAssignee")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  aiInsights      AIInsight[] @relation("AIInsightActor")
  vendor          Vendor?
  landlord        Landlord?
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ---------------------------------------------------------------------
// Agency / org
// ---------------------------------------------------------------------

model Agency {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  domain        String?
  logoUrl       String?
  brandColor    String?  @default("#0B3C5D")
  size          String?
  timezone      String?  @default("America/Chicago")
  isActive      Boolean  @default(true)
  ownerId       String?
  owner         User?    @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]            @relation("AgencyUsers")
  members       AgencyMember[]
  candidates    Candidate[]
  offers        Offer[]
  bookings      BookingRequest[]
  conciergeTasks ConciergeTask[]
  vendors       Vendor[]
  subscription  AgencySubscription?
  payments      PaymentRecord[]
  documents     DocumentVault[]
  mspReports    MSPReport[]
  assignments   Assignment[]
}

model AgencyMember {
  id        String   @id @default(uuid())
  agencyId  String
  userId    String
  role      UserRole
  title     String?
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([agencyId, userId])
}

// ---------------------------------------------------------------------
// Candidate / Clinician
// ---------------------------------------------------------------------

model Candidate {
  id            String   @id @default(uuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  firstName     String
  lastName      String
  email         String
  phone         String?
  role          String?
  specialty     String?
  licenseState  String?
  yearsExperience Int?
  city          String?
  state         String?
  status        String?  @default("active")
  engagementScore Int?   @default(50)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offers        Offer[]
  assignments   Assignment[]
  bookings      BookingRequest[]
  riskScores    RetentionRiskScore[]
  aiInsights    AIInsight[]
  activities    ActivityLog[]
  documents     DocumentVault[]
}

// ---------------------------------------------------------------------
// Offer + Assignment
// ---------------------------------------------------------------------

model Offer {
  id              String      @id @default(uuid())
  publicToken     String      @unique @default(uuid())
  agencyId        String
  agency          Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  recruiterId     String?
  recruiter       User?       @relation("OfferRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  candidateId     String
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Assignment info
  facilityName    String
  city            String
  state           String
  startDate       DateTime?
  durationWeeks   Int?
  shift           String?
  specialty       String?
  mspClient       String?

  // Compensation
  weeklyPay       Decimal?    @db.Decimal(10, 2)
  taxableRate     Decimal?    @db.Decimal(10, 2)
  stipend         Decimal?    @db.Decimal(10, 2)
  totalContractValue Decimal? @db.Decimal(12, 2)

  // Mobility perks (toggle cards)
  flightSupport   Boolean     @default(false)
  housingAssist   Boolean     @default(false)
  carRental       Boolean     @default(false)
  relocationConcierge Boolean @default(false)
  firstWeekReadiness  Boolean @default(false)
  emergencyHousing    Boolean @default(false)
  loyaltyRewards      Boolean @default(false)

  // AI-generated content
  enhancedSummary    String? @db.Text
  candidateValueStmt String? @db.Text
  recruiterTalkingPoints String? @db.Text
  smsPitch           String? @db.Text
  emailPitch         String? @db.Text
  closeStrategy      String? @db.Text
  confidenceScore    Int?

  status          OfferStatus @default(DRAFT)
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  perks           OfferPerk[]
  bookingRequests BookingRequest[]
  riskScores      RetentionRiskScore[]
  activities      ActivityLog[]
  assignment      Assignment?

  @@index([agencyId, status])
  @@index([candidateId])
}

model OfferPerk {
  id        String  @id @default(uuid())
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  type      String
  label     String
  detail    String? @db.Text
  estValue  Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Assignment {
  id            String  @id @default(uuid())
  offerId       String  @unique
  offer         Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  agencyId      String
  agency        Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  status        AssignmentStatus @default(PENDING)
  startDate     DateTime?
  endDate       DateTime?

  housingStatus     ChecklistStatus @default(NOT_STARTED)
  travelStatus      ChecklistStatus @default(NOT_STARTED)
  documentsStatus   ChecklistStatus @default(NOT_STARTED)
  firstWeekStatus   ChecklistStatus @default(NOT_STARTED)
  readinessScore    Int @default(0)
  riskScore         Int @default(0)
  riskLevel         RiskLevel @default(LOW)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([agencyId, status])
}

// ---------------------------------------------------------------------
// Booking + Marketplace
// ---------------------------------------------------------------------

model BookingRequest {
  id             String   @id @default(uuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offerId        String?
  offer          Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  needFlight     Boolean  @default(false)
  needHousing    Boolean  @default(false)
  needCar        Boolean  @default(false)
  moveDate       DateTime?
  budgetMin      Decimal? @db.Decimal(10,2)
  budgetMax      Decimal? @db.Decimal(10,2)
  preferredLocation String?
  notes          String?  @db.Text

  status         BookingStatus @default(NEW)
  conciergeOwnerId String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conciergeTasks ConciergeTask[]
  housingOption  HousingOption? @relation(fields: [housingOptionId], references: [id])
  housingOptionId String?
  travelOption   TravelOption?  @relation(fields: [travelOptionId], references: [id])
  travelOptionId String?
  carRentalOption CarRentalOption? @relation(fields: [carRentalOptionId], references: [id])
  carRentalOptionId String?

  @@index([agencyId, status])
}

model HousingOption {
  id           String  @id @default(uuid())
  landlordId   String?
  landlord     Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)
  title        String
  description  String? @db.Text
  city         String
  state        String
  address      String?
  bedrooms     Int?
  bathrooms    Float?
  monthlyCost  Decimal? @db.Decimal(10,2)
  distanceMiles Float?
  available    Boolean  @default(true)
  verification VerificationStatus @default(PENDING)
  rating       Float?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     BookingRequest[]

  @@index([city, state])
}

model TravelOption {
  id           String  @id @default(uuid())
  vendorId     String?
  vendor       Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  type         String
  origin       String?
  destination  String?
  estCost      Decimal? @db.Decimal(10,2)
  notes        String? @db.Text
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  bookings     BookingRequest[]
}

model CarRentalOption {
  id           String  @id @default(uuid())
  vendorId     String?
  vendor       Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  city         String
  state        String
  carClass     String?
  weeklyCost   Decimal? @db.Decimal(10,2)
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  bookings     BookingRequest[]
}

model Vendor {
  id           String  @id @default(uuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId     String?
  agency       Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  type         VendorType
  name         String
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  description  String? @db.Text
  rating       Float?
  verification VerificationStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  travelOptions  TravelOption[]
  carOptions     CarRentalOption[]
}

model Landlord {
  id           String  @id @default(uuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  about        String? @db.Text
  rating       Float?
  verification VerificationStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  housing      HousingOption[]
}

// ---------------------------------------------------------------------
// Concierge tasks
// ---------------------------------------------------------------------

model ConciergeTask {
  id           String  @id @default(uuid())
  agencyId     String
  agency       Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      BookingRequest? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?   @relation("ConciergeAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title        String
  description  String? @db.Text
  status       BookingStatus @default(NEW)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId, status])
}

// ---------------------------------------------------------------------
// Risk + AI Insights
// ---------------------------------------------------------------------

model RetentionRiskScore {
  id           String  @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offerId      String?
  offer        Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  score        Int
  level        RiskLevel
  reasoning    String  @db.Text
  suggestedAction String? @db.Text
  suggestedSms String? @db.Text
  suggestedCallScript String? @db.Text
  createdAt    DateTime @default(now())

  @@index([candidateId, createdAt])
}

model AIInsight {
  id           String  @id @default(uuid())
  agent        String
  prompt       String  @db.Text
  output       String  @db.Text
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?   @relation("AIInsightActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata     Json?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------
// Notifications + Activity + Audit
// ---------------------------------------------------------------------

model Notification {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(SYSTEM)
  title       String
  message     String  @db.Text
  link        String?
  isRead      Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id          String  @id @default(uuid())
  actorId     String?
  actor       User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  offerId     String?
  offer       Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  action      String
  description String? @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([offerId, createdAt])
}

model AuditLog {
  id          String  @id @default(uuid())
  actorId     String?
  actor       User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      AuditAction
  entity      String
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------

model SubscriptionPlan {
  id           String  @id @default(uuid())
  tier         SubscriptionTier @unique
  name         String
  monthlyPrice Decimal @db.Decimal(10,2)
  annualPrice  Decimal @db.Decimal(10,2)
  features     Json
  isFeatured   Boolean @default(false)
  createdAt    DateTime @default(now())
  subscriptions AgencySubscription[]
}

model AgencySubscription {
  id           String   @id @default(uuid())
  agencyId     String   @unique
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  planId       String
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIALING)
  startedAt    DateTime  @default(now())
  trialEndsAt  DateTime?
  renewsAt     DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PaymentRecord {
  id          String   @id @default(uuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(10,2)
  currency    String   @default("usd")
  status      String
  description String?
  invoiceUrl  String?
  stripePaymentId String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------
// Documents + MSP Reports
// ---------------------------------------------------------------------

model DocumentVault {
  id          String   @id @default(uuid())
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  title       String
  category    String
  url         String?
  status      String   @default("pending")
  expiresAt   DateTime?
  uploadedAt  DateTime @default(now())
  metadata    Json?
}

model MSPReport {
  id          String   @id @default(uuid())
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  title       String
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  summary     String?  @db.Text
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------
// Lead capture / demo
// ---------------------------------------------------------------------

model Lead {
  id          String   @id @default(uuid())
  name        String
  email       String
  company     String?
  phone       String?
  role        String?
  source      String?
  message     String?  @db.Text
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model DemoRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  company     String?
  phone       String?
  role        String?
  teamSize    String?
  preferredTime DateTime?
  notes       String?  @db.Text
  status      String   @default("requested")
  createdAt   DateTime @default(now())
}
